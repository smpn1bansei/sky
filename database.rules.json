{
  "rules": {
    ".read": false,
    ".write": false,
    "guru": {
      ".read": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$email": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $email",
        ".write": "(auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true && auth.token.email.toLowerCase().replace('.', ',') !== $email) || (auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $email && !root.child('guru').exists())",
        ".validate": "newData.val() === true"
      }
    },
    "paket": {
      ".read": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "soal": {
      ".read": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$paketId": {
        ".read": "auth != null"
      }
    },
    "kunci": {
      ".read": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$paketId": {
        "$soalId": {
          ".validate": "newData.isString() && newData.val().matches(/^[abcd]$/)"
        }
      }
    },
    "daftarRoom": {
      ".read": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "rooms": {
      "$pin": {
        ".read": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
        ".write": "auth != null && auth.token.email != null && root.child('guru').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
        "info": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['paketId', 'jumlahSoal', 'waktuPerSoal', 'mode', 'status'])",
          "status": {
            ".validate": "newData.val() === 'menunggu' || newData.val() === 'berjalan' || newData.val() === 'selesai'"
          }
        },
        "namaIndex": {
          "$sid": {
            ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && root.child('rooms').child($pin).child('info/status').exists() && root.child('rooms').child($pin).child('info/status').val() !== 'selesai'"
          }
        },
        "siswa": {
          "$sid": {
            ".read": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
            "nama": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid && !data.exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "kelas": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid && !data.exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "pemilik": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid && !data.exists()",
              ".validate": "newData.val() === auth.uid"
            },
            "urutan": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid && !data.exists()",
              "$soalId": {
                ".validate": "newData.isNumber() && root.child('soal').child(root.child('rooms').child($pin).child('info/paketId').val()).child($soalId).exists()"
              }
            },
            "soalKe": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "benar": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "salah": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "skor": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "nilai": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "tabrakan": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "cincin": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "fokus": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "status": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.val() === 'menunggu' || newData.val() === 'bermain' || newData.val() === 'selesai'"
            },
            "online": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isBoolean()"
            },
            "bergabung": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid && !data.exists()",
              ".validate": "newData.isNumber()"
            },
            "terakhirAktif": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
              ".validate": "newData.isNumber()"
            },
            "$lain": {
              ".validate": false
            }
          }
        },
        "jawaban": {
          "$sid": {
            ".read": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid",
            "$soalId": {
              ".write": "auth != null && root.child('rooms').child($pin).child('namaIndex').child($sid).val() === auth.uid && !data.exists() && root.child('rooms').child($pin).child('info/status').val() === 'berjalan' && root.child('rooms').child($pin).child('siswa').child($sid).child('urutan').child($soalId).exists()",
              ".validate": "newData.hasChildren(['pilihan', 'benar', 'waktu']) && newData.child('benar').val() === (newData.child('pilihan').val() === root.child('kunci').child(root.child('rooms').child($pin).child('info/paketId').val()).child($soalId).val())",
              "pilihan": {
                ".validate": "newData.isString() && newData.val().matches(/^[abcd-]$/)"
              },
              "benar": {
                ".validate": "newData.isBoolean()"
              },
              "waktu": {
                ".validate": "newData.val() === now"
              },
              "durasi": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$lain": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
